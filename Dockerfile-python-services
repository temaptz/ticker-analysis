FROM dockerhub.timeweb.cloud/library/python:3.12-slim-bookworm AS requirements

# Переводим Debian-репозитории базового образа на российское зеркало
RUN sed -i 's|deb.debian.org|mirror.yandex.ru|g' /etc/apt/sources.list.d/debian.sources && \
    apt-get update && \
    apt-get install -y --no-install-recommends wget gnupg2 lsb-release curl ca-certificates

# Подключаем PGDG через зеркало Яндекса (ключ совпадает с официальным)
RUN curl -fsSL -o /usr/share/keyrings/pgdg.asc \
        https://mirror.yandex.ru/mirrors/postgresql/ACCC4CF8.asc && \
    echo "deb [signed-by=/usr/share/keyrings/pgdg.asc] https://mirror.yandex.ru/mirrors/postgresql $(lsb_release -cs)-pgdg main" \
        > /etc/apt/sources.list.d/pgdg.list

RUN apt-get update && \
    apt-get install -y --no-install-recommends procps postgresql-client-17 && \
    apt-get install -y --no-install-recommends build-essential cmake git python3-dev && \
    apt-get clean && rm -rf /var/lib/apt/lists/*

WORKDIR /app
ENV PYTHONPATH=/app
ENV PYTHONUNBUFFERED=1

COPY ./requirements.txt /app/requirements.txt
RUN pip install --no-cache-dir -r requirements.txt \
    --index-url https://pypi-mirror.gitverse.ru/simple/ \
    --extra-index-url https://mirror.yandex.ru/pypi/web/simple/ \
    --extra-index-url https://pypi.org/simple/ \
    --retries 10 --timeout 120


FROM requirements

COPY ./lib /app/lib
COPY ./t_tech /app/t_tech
COPY ./main.py /app/main.py
COPY ./learn.py /app/learn.py
COPY predict.py /app/predict.py
COPY ./news_rate.py /app/news_rate.py
COPY ./fast_api.py /app/fast_api.py
COPY ./const.py /app/const.py
COPY ./.env /app/.env
COPY ./mcp_server.py /app/mcp_server.py